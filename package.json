{
  "name": "obsidian-writing-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r typecheck",
    "dev:api": "corepack pnpm --filter @oww/api-server dev",
    "dev:mcp": "corepack pnpm --filter @oww/mcp-server dev",
    "dev:worker": "corepack pnpm --filter @oww/worker dev",
    "refresh:worker": "corepack pnpm --filter @oww/worker refresh",
    "demo:related": "node --import tsx/esm examples/flows/topic-to-related.ts",
    "demo:draft": "node --import tsx/esm examples/flows/topic-to-draft.ts",
    "demo:v2": "node --import tsx/esm examples/flows/topic-to-related.ts && node --import tsx/esm examples/flows/topic-to-draft.ts"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
