{
  "name": "obsidian-writing-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-isolation=none e2e/dev-vault.e2e.test.mjs e2e/api-http.e2e.test.mjs e2e/mcp-stdio.e2e.test.mjs",
    "test:e2e:api": "node --test --test-isolation=none e2e/api-http.e2e.test.mjs",
    "test:e2e:mcp": "node --test --test-isolation=none e2e/mcp-stdio.e2e.test.mjs",
    "seed:dev-vault": "node --import tsx/esm scripts/seed-dev-vault.ts",
    "seed:dev-vault:clean": "node --import tsx/esm scripts/seed-dev-vault.ts --clean",
    "smoke:dev-vault": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "corepack pnpm -r typecheck",
    "dev:api": "corepack pnpm --filter @oww/api-server dev",
    "dev:mcp": "corepack pnpm --filter @oww/mcp-server dev",
    "dev:worker": "corepack pnpm --filter @oww/worker dev",
    "refresh:worker": "corepack pnpm --filter @oww/worker refresh",
    "demo:related": "node --import tsx/esm examples/flows/topic-to-related.ts",
    "demo:draft": "node --import tsx/esm examples/flows/topic-to-draft.ts",
    "demo:v2": "node --import tsx/esm examples/flows/topic-to-related.ts && node --import tsx/esm examples/flows/topic-to-draft.ts"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
